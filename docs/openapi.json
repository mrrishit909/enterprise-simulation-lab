 "components": {
  "schemas": {
   "ApproveIn": {
    "properties": {
     "final_outcome": {
      "type": "string",
      "enum": [
       "adopt",
       "reject",
       "staged_test",
       "defer"
      ],
      "title": "Final Outcome",
      "description": "what the approver decided; may differ from the policy's recommendation"
     },
     "note": {
      "type": "string",
      "maxLength": 400,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "final_outcome",
     "note"
    ],
    "title": "ApproveIn"
   },
   "Arm": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1,
      "title": "Name"
     },
     "price_change": {
      "type": "number",
      "maximum": 0.5,
      "minimum": -0.3,
      "title": "Price Change",
      "description": "applied to every market from `month`",
      "default": 0.0
     },
     "month": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Month",
      "default": 1
     },
     "competitor": {
      "type": "string",
      "enum": [
       "reactive",
       "none",
       "discount"
      ],
      "title": "Competitor",
      "description": "reactive: its own promotions and reactions as calibrated; none: holds its price; discount: the scenario's discount in every market",
      "default": "reactive"
     },
     "discount": {
      "type": "number",
      "maximum": 0.6,
      "minimum": 0.0,
      "title": "Discount",
      "default": 0.2
     },
     "discount_start": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Discount Start",
      "default": 2
     },
     "discount_months": {
      "type": "integer",
      "maximum": 24.0,
      "minimum": 1.0,
      "title": "Discount Months",
      "default": 3
     }
    },
    "type": "object",
    "required": [
     "name"
    ],
    "title": "Arm"
   },
   "BatchIn": {
    "properties": {
     "arms": {
      "items": {
       "$ref": "#/components/schemas/Arm"
      },
      "type": "array",
      "maxItems": 4,
